+/* Curl_cffi rework: TRUE when the peer has already half-closed the TCP
+ * connection with a bare FIN. Doing a non-blocking peek lets us tell a FIN
+ * apart from real pending data, even after the TLS layer consumed a
+ * close_notify that was sent in front of it. */
+static bool cf_h2_peer_fin(struct Curl_cfilter *cf, struct Curl_easy *data)
+{
+  curl_socket_t sock = Curl_conn_cf_get_socket(cf, data);
+  struct pollfd pfd[1];
+
+  if(sock == CURL_SOCKET_BAD)
+    return TRUE;
+
+  pfd[0].fd = sock;
+  pfd[0].events = POLLIN | POLLRDNORM;
+  pfd[0].revents = 0;
+  if(Curl_poll(pfd, 1, 0) <= 0)
+    return FALSE;                       /* nothing pending: peer still there */
+  if(pfd[0].revents & (POLLERR | POLLHUP | POLLNVAL))
+    return TRUE;                        /* socket broke */
+  if(!(pfd[0].revents & (POLLIN | POLLRDNORM)))
+    return FALSE;
+#ifdef MSG_PEEK
+  {
+    char b[1];
+    ssize_t n = recv(sock, b, 1, MSG_PEEK);
+    return (n == 0);                    /* 0 = EOF/FIN, >0 = real data */
+  }
+#else
+  return FALSE;
+#endif
+}
