+/* Curl_cffi rework (nb-curl): Chromium based browsers set the (deprecated)
+ * RFC 7540 PRIORITY flag on every request HEADERS frame and carry E=1,
+ * dependency 0 and the stream weight in it. nghttp2 ignores the priority spec
+ * handed to nghttp2_submit_request these days, so the 5 priority bytes are
+ * inserted into the serialized frame here, right before it reaches the
+ * connection. nghttp2 hands over a frame in one piece as long as it fits into
+ * an output chunk (see NGHTTP2_OB_SEND_DATA in nghttp2), hence "frame length ==
+ * buffer length" below identifies a complete frame starting at the head of
+ * |buf|; a resend after a partial write starts mid frame and is left alone.
+ * Enabled per handle with CURLOPT_HTTP2_HEADERS_PRIORITY. */
+#define H2_PRIORITY_FLAG     0x20
+#define H2_PRIORITY_SPECLEN  5
+
+static bool h2_frame_needs_priority(const uint8_t *buf, size_t blen)
+{
+  size_t flen;
+  if(blen < 9)
+    return FALSE;
+  flen = ((size_t)buf[0] << 16) | ((size_t)buf[1] << 8) | (size_t)buf[2];
+  return (buf[3] == 0x01) &&             /* HEADERS frame */
+         !(buf[4] & H2_PRIORITY_FLAG) && /* no priority fields yet */
+         (blen >= 9 + flen);             /* first frame complete at buf[0] */
+}
+
+/* Return a copy of the HEADERS frame with the priority fields inserted after
+ * the frame header, or NULL when out of memory. */
+static uint8_t *h2_add_priority(const uint8_t *buf, size_t blen,
+                                const struct Curl_easy *data)
+{
+  uint8_t *n = curlx_malloc(blen + H2_PRIORITY_SPECLEN);
+  size_t flen;
+  int weight, exclusive;
+  uint32_t exdep;
+
+  if(!n)
+    return NULL;
+  /* Chrome's values for a navigation request; a preset may override them. */
+  weight = data->set.weight ? data->set.weight : 256;
+  exclusive = data->set.stream_exclusive ? 1 : 0;
+  memcpy(n, buf, 9);
+  flen = blen + H2_PRIORITY_SPECLEN - 9;
+  n[0] = (uint8_t)((flen >> 16) & 0xff);
+  n[1] = (uint8_t)((flen >> 8) & 0xff);
+  n[2] = (uint8_t)(flen & 0xff);
+  n[4] |= H2_PRIORITY_FLAG;
+  exdep = exclusive ? 0x80000000u : 0u;   /* dependency is always 0 */
+  n[9]  = (uint8_t)(exdep >> 24);
+  n[10] = 0;
+  n[11] = 0;
+  n[12] = 0;
+  n[13] = (uint8_t)((weight - 1) & 0xff); /* weight is 1..256 */
+  memcpy(n + 9 + H2_PRIORITY_SPECLEN, buf + 9, blen - 9);
+  return n;
+}
