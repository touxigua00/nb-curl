# nb-curl rework patch  (applies on top of curl-impersonate's curl.patch)
#
# Base:  upstream curl 8.22.0 (deps/sources/curl-8.22.0-upstream.tar.gz)
#        + deps/patches/curl.patch (curl-impersonate)
# Apply: patch -p1 -d curl-8.22.0 < deps/patches/nb_curl.patch
#
# This single file is the summary of ALL nb-curl-specific C changes.
# Every hunk is also annotated in the source with a "Curl_cffi rework:"
# comment (grep -rn "Curl_cffi rework" lib/).
#
# Summary of changes:
#
# lib/http2.c
#   1. cf_h2_peer_fin(): new helper - non-blocking poll + MSG_PEEK to tell
#      a peer TCP FIN apart from real pending data.
#   2. http2_data_done(): when the peer is already gone, suppress the
#      RST_STREAM that upstream flushes after the peer's FIN - browsers
#      just stop talking instead of writing a 13B frame on a half-closed
#      socket. THE main fix for "half_close_write" detection.
#   3. http2_connisalive(): after consuming buffered pending input (which
#      may hold a TLS close_notify), re-probe the lower filters so a FIN
#      hiding behind those bytes marks the connection dead and it is not
#      reused. Caps rounds so a chatty peer cannot spin.
#   4. cf_h2_connect_done(): flush preface+SETTINGS right after the H2
#      session is established so they are not coalesced with the first
#      request HEADERS (browsers send them separately).
#   5. cf_h2_shutdown(): never close first - wait (up to ~300ms) for the
#      peer FIN and then answer with a bare FIN; skip GOAWAY.
#   6. nghttp2_submit_request(): CURLOPT_HTTP2_HEADERS_PRIORITY is now the
#      single switch for the deprecated RFC 7540 priority fields (E,
#      dependency, weight) in the HEADERS frame. nghttp2 versions differ:
#      1.68 and newer ignore the pri_spec handed to nghttp2_submit_request
#      (the five bytes are inserted by hand in the lower send path
#      instead), while older ones (1.59, as shipped by e.g. Ubuntu 24.04)
#      still emit them themselves - which made the option a no-op on those
#      builds, so pri_spec is gated in http2.c as well. Both paths can be
#      active at once without duplicating the fields: the send path checks
#      the priority flag before rewriting.
#
# lib/conncache.c
#   7. cpool_conn_is_alive(): drop the "<1s since last check" shortcut -
#      always run the alive check, so a server that closes right after
#      responding is never blindly reused.
#
# lib/cf-socket.c
#   8. cf_socket_close(): send our FIN first (bare half-close) instead of
#      relying on RST-by-lingering, then drain dangling bytes.
#   9. cf_socket_is_alive(): on a readable event, MSG_PEEK one byte to
#      distinguish pending data from EOF before declaring the conn alive.
#
# lib/vtls/openssl.c
#  10. ossl_shutdown(): if the peer already sent a raw FIN, skip sending
#      our TLS close_notify (writing after the peer half-closed is the
#      "half-close write" tell) - just mark the connection closed.
#  11. kMaxSignatureAlgorithmNameLen: static const -> #define so MSVC
#      accepts it as an array size in C mode.
#  12. Curl_ossl_ctx_init(): enable SSL_CTX_set_grease_sigalgs_enabled()
#      when CURLOPT_TLS_GREASE_SIGALGS is set - random GREASE value at the
#      head of the signature_algorithms extension (Chrome 152+ behavior).
#  13. set_trust_anchors(): curl-impersonate permutes the trust_anchors
#      (51764) list with a fresh Curl_rand() draw on EVERY connection. A
#      live Chrome 152 sent byte-identical 186-byte lists on 30 consecutive
#      connections and switched to a different order only on a later browser
#      run: the permutation is fixed for the lifetime of the browser
#      process. Ours now seeds a xorshift32 once per process, so all
#      connections of one run agree with each other (and runs still differ).
#      Only the temporary wire order changes; the configured value stays
#      untouched, so connection and session cache keys are unaffected.
#
# lib/impersonate.c
#  14. chrome131 / chrome146 / chrome150 / firefox147 presets: default
#      headers announce Windows instead of macOS (sec-ch-ua-platform and
#      User-Agent). TLS fingerprint unchanged. New "chrome152" preset,
#      captured from a real browser (2026-09-11, Windows x64): chrome150
#      TLS base + GREASE in signature_algorithms (tls_grease_sigalgs) +
#      trust_anchors(51764) + Chrome 152 default headers.
#  15. chrome152: trust_anchors(51764) now carries the 28 trust anchor IDs
#      of Chrome's built-in root store instead of an empty list. It used to
#      be empty because xcctls.top/all reports the extension without a
#      dumpable payload, and that empty payload was mistaken for "Chrome
#      sends an empty list". A real Chrome 152 always sends those 28 IDs
#      (verified against a live capture, 2026-09-22); they match the
#      trust_anchor_id fields of Chromium's
#      net/data/ssl/chrome_root_store/root_store.textproto one for one.
#      The chrome152 entry also gained the HTTP/3 (QUIC) fingerprint fields
#      inherited from chrome150, which had been missing from the patch.
#
# include/curl/curl.h, lib/urldata.h, lib/setopt.c, lib/easyoptions.c,
# lib/easy.c, lib/impersonate.h
#  16. New option CURLOPT_TLS_GREASE_SIGALGS (LONG 1041): data->set ->
#      SSL_CTX_set_grease_sigalgs_enabled(); wired into the impersonate
#      options struct so presets can turn it on.
#
# lib/vquic/cf-ngtcp2.c
#  17. (2026-09-16 曾移除，2026-09-17 恢复) H3 custom-settings 支持：
#      h3_apply_setting / h3_setting_supported / h3_rand_u32 /
#      h3_generate_grease_setting / h3_settings_count / populate_h3_settings
#      与 init_ngh3_conn 里的 nghttp3_conn_submit_settings 调用，即
#      curl-impersonate 原版实现（CURLOPT_HTTP3_SETTINGS 串
#      "id:value;..." + "GREASE" 令牌）。当时移除的原因是这些符号不在
#      任何官方版 nghttp3 里；现在我们把 curl-impersonate 的 nghttp3
#      补丁重定基到 v1.18（deps/patches/nghttp3.patch，应用于
#      deps/sources/nghttp3-src），补齐了 nghttp3_conn_submit_settings
#      公开 API，于是原样恢复。chrome150/152 与 firefox147 预设的
#      H3 SETTINGS 指纹（含 GREASE 条目）由此生效；未设置
#      CURLOPT_HTTP3_SETTINGS 时行为与官方 curl 一致。
#
# lib/vquic/cf-ngtcp2-cmn.c
#  18. Removed curl-impersonate's raw QUIC transport params override block
#      (ngtcp2_conn_set_local_transport_params_raw +
#      ngtcp2_transport_params_raw) in cf_ngtcp2_ctx_setup. These symbols
#      do NOT exist in ANY stock ngtcp2 release (v1.17.0-v1.25.0 verified);
#      curl-impersonate's patch requires a custom-forked ngtcp2. QUIC
#      transport param raw fingerprinting is lost; the tp_raw dynbuf stays
#      initialized but unconsumed (harmless). Matches curl_cffi's approach.
#
